// Copiar para wrangler.jsonc depois de criar o banco D1 e o cliente OAuth do Google.
{
  "name": "fluency-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "nowish", "database_id": "COLE_AQUI_O_DATABASE_ID" }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "COLE_AQUI_O_CLIENT_ID.apps.googleusercontent.com",
    "MAIL_FROM": "nowish <entrar@momnt.com.br>",
    "APP_NAME": "nowish"
  }
  // Segredo no painel do Cloudflare (Settings → Variables and Secrets): RESEND_API_KEY
}
